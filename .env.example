# API de narrativa IA (GROQ) — usada por api/evento.js y api/generar-evento.js
# (serverless, backend). NUNCA exponer la key al cliente/bundle (por eso no
# lleva prefijo VITE_).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usada por scripts/seed-players.js (ingesta desde la API de Football Data).
API_FOOTBALL_KEY=

# Usadas por scripts/seed-events-catalog.js y scripts/reconcile.js (backend,
# bypassea RLS). NUNCA exponer SUPABASE_SERVICE_KEY al cliente/bundle
# (por eso no lleva prefijo VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
